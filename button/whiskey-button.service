[Unit]
Description=Whiskey Button — GPIO relay dispenser controller
After=multi-user.target
# Never give up restarting — keep the dispenser running no matter what.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/whiskey-button/whiskey_button.py
WorkingDirectory=/opt/whiskey-button
Environment=PYTHONIOENCODING=utf-8
EnvironmentFile=/etc/whiskey-button/env
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
